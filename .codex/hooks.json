{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Bottle.aiff >/dev/null 2>&1",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Bottle.aiff >/dev/null 2>&1",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1",
            "async": true
          }
        ]
      }
    ]
  }
}
